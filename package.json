{
  "name": "tripon-workspace",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "pnpm --parallel --filter @tripon/search-api --filter @tripon/web dev",
    "dev:web": "pnpm --filter @tripon/web dev",
    "dev:search": "pnpm --filter @tripon/search-api dev",
    "build": "pnpm --filter @tripon/web build",
    "build:web": "pnpm --filter @tripon/web build",
    "lint": "pnpm --filter @tripon/web lint",
    "typecheck": "pnpm --filter @tripon/search-api typecheck && pnpm --filter @tripon/web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
